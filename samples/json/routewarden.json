{
  "$schema": "https://routewarden.github.io/schema/v2/config.schema.json",
  "enabled": true,
  "enableDefaultPatterns": true,
  "enableDefaultAllowPatterns": true,
  "pathPatterns": [
    "(?i)^/admin/secret.*$",
    "(?i)^/internal/metrics.*$"
  ],
  "allowPatterns": [
    "(?i)^/internal/metrics/public$"
  ],
  "allowedIps": [
    "192.168.100.50",
    "10.99.0.0/16"
  ],
  "methods": [
    "GET",
    "POST"
  ],
  "checkQuery": true,
  "checkHeaders": [
    "X-Forwarded-Uri",
    "X-Original-URL"
  ],
  "response": {
    "mode": "json",
    "statusCode": 403,
    "body": "{\"error\":\"Access Denied: Protected by RouteWarden\",\"schema\":\"routewarden.json\"}",
    "headers": {
      "X-Protection-Provider": "RouteWarden"
    }
  }
}
