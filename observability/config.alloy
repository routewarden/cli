// Grafana Alloy Configuration for RouteWarden Security Observability
// Ingests, parses, enriches, and ships RouteWarden security logs to Loki

// -----------------------------------------------------------------------------
// 1. Docker Container Discovery & Log Ingestion
// -----------------------------------------------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "routewarden_containers" {
  targets = discovery.docker.containers.targets

  // Pure Opt-In: ONLY scrape containers explicitly labeled for RouteWarden logging
  rule {
    source_labels = [
      "__meta_docker_container_label_routewarden_logs",
      "__meta_docker_container_label_routewarden",
    ]
    separator     = ";"
    regex         = ".*(true|1|yes).*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.routewarden_containers.output
  forward_to = [loki.process.routewarden.receiver]
}

// -----------------------------------------------------------------------------
// 2. File Tailing for Host Log Files
// -----------------------------------------------------------------------------
local.file_match "routewarden_files" {
  path_targets = [
    { "__path__" = "/var/log/routewarden/*.log" },
    { "__path__" = "/var/log/routewarden/*.json" },
    { "__path__" = "/var/log/routewarden/*.jsonl" },
  ]
}

loki.source.file "host_logs" {
  targets    = local.file_match.routewarden_files.targets
  forward_to = [loki.process.routewarden.receiver]
}

// -----------------------------------------------------------------------------
// 3. UDP Syslog Receiver (for streaming logs over network UDP)
// -----------------------------------------------------------------------------
loki.source.syslog "syslog_udp" {
  listener {
    address               = "0.0.0.0:1514"
    protocol              = "udp"
    use_rfc5424_message   = false
    labels                = { app = "routewarden", transport = "udp", source = "syslog_udp" }
  }
  forward_to = [loki.process.routewarden.receiver]
}

// -----------------------------------------------------------------------------
// 4. Log Processing & JSON Field Parsing (HTTP & UDP/TCP L4)
// -----------------------------------------------------------------------------
loki.process "routewarden" {
  forward_to = [loki.write.local_loki.receiver]

  // Parse structured JSON emitted by RouteWarden security loggers (Layer 7 & Layer 4 UDP/TCP)
  stage.json {
    expressions = {
      timestamp       = "timestamp",
      type            = "type",
      level           = "level",
      verdict         = "verdict",
      action          = "action",
      client_ip       = "client_ip",
      ip              = "ip",
      effective_ip    = "effective_ip",
      method          = "method",
      protocol        = "protocol",
      service         = "service",
      transport       = "transport",
      path            = "path",
      status_code     = "status_code",
      matched_pattern = "matched_pattern",
      rule_id         = "rule_id",
      gateway         = "gateway",
      plugin          = "plugin",
      response_mode   = "response_mode",
      country_code    = "country_code",
      country_name    = "country_name",
      flag_emoji      = "flag_emoji",
      reason          = "reason",
      bytes_in        = "bytes_in",
      bytes_out       = "bytes_out",
      latency_ms      = "latency_ms",
      duration_ms     = "duration_ms",
      user_agent      = "user_agent",
    }
  }

  // Normalize client_ip and ip
  stage.template {
    source   = "client_ip"
    template = "{{ if .client_ip }}{{ .client_ip }}{{ else if .ip }}{{ .ip }}{{ else if .effective_ip }}{{ .effective_ip }}{{ end }}"
  }

  // Infer or normalize log level (warn / info / error)
  stage.template {
    source   = "level"
    template = "{{ if .level }}{{ .level }}{{ else if or (eq .verdict \"BLOCK\") (eq .action \"blocked\") (eq .action \"banned\") }}warn{{ else if eq .action \"throttled\" }}warn{{ else if or (eq .verdict \"ALLOW\") (eq .action \"allowed\") (eq .action \"bypassed\") }}info{{ else }}info{{ end }}"
  }

  // Normalize transport (fallback to protocol default if missing)
  stage.template {
    source   = "transport"
    template = "{{ if .transport }}{{ .transport }}{{ else if or (eq .protocol \"dns\") (eq .protocol \"dht\") (eq .protocol \"udp\") }}udp{{ else }}tcp{{ end }}"
  }

  // Drop any log lines that do not have a RouteWarden verdict or action
  // This discards container startup logs, health check probes, and plain-text noise
  stage.drop {
    source     = "verdict"
    expression = "^$"
  }

  // Default app label (only applied to retained RouteWarden events)
  stage.static_labels {
    values = {
      app = "routewarden",
    }
  }

  // Normalize gateway (fallback to plugin if gateway is empty)
  stage.template {
    source   = "gateway"
    template = "{{ if .gateway }}{{ .gateway }}{{ else if .plugin }}{{ .plugin }}{{ else }}gateway{{ end }}"
  }

  // Normalize verdict across all gateways:
  // - HTTP gateways (Traefik, Caddy, NGINX): type="routewarden_block" -> verdict="BLOCK"
  // - TCP Warden: action="blocked" -> verdict="BLOCK", action="allowed" -> verdict="ALLOW", action="throttled" -> verdict="THROTTLED"
  // - Direct verdict field (verdict="BLOCK" / "ALLOW" / "BYPASS")
  stage.template {
    source   = "verdict"
    template = "{{ if .verdict }}{{ .verdict }}{{ else if eq .type \"routewarden_block\" }}BLOCK{{ else if eq .type \"routewarden_allow\" }}ALLOW{{ else if eq .action \"blocked\" }}BLOCK{{ else if eq .action \"allowed\" }}ALLOW{{ else if eq .action \"throttled\" }}THROTTLED{{ else if eq .action \"banned\" }}BLOCK{{ else if .action }}{{ .action }}{{ end }}"
  }

  // Infer response_mode for HTTP gateways when action represents the mode (e.g. text, json, silentDrop)
  stage.template {
    source   = "response_mode"
    template = "{{ if .response_mode }}{{ .response_mode }}{{ else if eq .type \"routewarden_block\" }}{{ .action }}{{ else }}default{{ end }}"
  }

  // Drop any log lines that do not have a RouteWarden verdict
  // This discards container startup logs, health check probes, and plain-text noise
  stage.drop {
    source     = "verdict"
    expression = "^$"
  }

  // Default app label (only applied to retained RouteWarden events)
  stage.static_labels {
    values = {
      app = "routewarden",
    }
  }

  // Promote key low-to-medium cardinality keys to fast Loki labels for instant filtering
  stage.labels {
    values = {
      level         = "level",
      verdict       = "verdict",
      action        = "action",
      gateway       = "gateway",
      service       = "service",
      protocol      = "protocol",
      transport     = "transport",
      client_ip     = "client_ip",
      country_code  = "country_code",
      status_code   = "status_code",
      method        = "method",
      response_mode = "response_mode",
      reason        = "reason",
    }
  }

  // Promote high-cardinality query fields to Loki structured metadata and log inspector
  stage.structured_metadata {
    values = {
      client_ip       = "client_ip",
      ip              = "client_ip",
      effective_ip    = "effective_ip",
      service         = "service",
      country_name    = "country_name",
      flag_emoji      = "flag_emoji",
      path            = "path",
      matched_pattern = "matched_pattern",
      rule_id         = "rule_id",
      user_agent      = "user_agent",
      reason          = "reason",
      bytes_in        = "bytes_in",
      bytes_out       = "bytes_out",
      duration_ms     = "duration_ms",
      latency_ms      = "latency_ms",
    }
  }
}

// -----------------------------------------------------------------------------
// 5. Output: Ship to Loki
// -----------------------------------------------------------------------------
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
