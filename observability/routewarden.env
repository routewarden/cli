# ─── RouteWarden Observability Stack — Environment Configuration ───────────────
#
# Copy this file to .env or export variables to your shell before running:
#   docker compose up -d
#
# ─── Grafana ───────────────────────────────────────────────────────────────────

# Port Grafana listens on (default: 3000)
GRAFANA_PORT=3000

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ─── Grafana Advanced ──────────────────────────────────────────────────────────

# Allow anonymous read-only access without login
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# Disable new user self-registration
GF_USERS_ALLOW_SIGN_UP=false

# Allow Grafana to be embedded in iframes (e.g., RouteWarden web UI)
GF_SECURITY_ALLOW_EMBEDDING=true

# Enable public dashboards feature toggle
GF_FEATURE_TOGGLES_ENABLE=publicDashboards

# Home dashboard shown after login (absolute path inside the container)
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/routewarden-overview.json

# ─── Loki ──────────────────────────────────────────────────────────────────────

# Port Loki log engine listens on (default: 3100)
LOKI_PORT=3100

# ─── Threat Alerting (optional) ────────────────────────────────────────────────
#
# Alerting is DISABLED by default to allow zero-config startup.
# To enable the 4 pre-configured threat alert rules, uncomment the line below:
#
# ALERTING_PROVISIONING_DIR=./grafana/provisioning/alerting
#
# Webhook destination for threat alerts (Grafana → your endpoint):
# ALERT_WEBHOOK_URL=https://your-soc-endpoint.example.com/alerts
#
# ─── Optional Notification Channels ───────────────────────────────────────────
# Uncomment each block in grafana/provisioning/alerting/alerting.yaml
# and configure the corresponding environment variable below:
#
# Slack (requires an Incoming Webhook URL from api.slack.com/apps)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# Discord (requires a Webhook URL from Server Settings > Integrations)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
#
# PagerDuty (requires an Integration Key from a PagerDuty Events API v2 service)
# PAGERDUTY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
